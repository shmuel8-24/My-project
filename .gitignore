# Environment variables — NEVER commit these
.env
.env.*
!.env.example
!backend/.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env.bak

# Distribution / packaging
*.whl
*.tar.gz

# Testing
.pytest_cache/
.coverage
htmlcov/

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# Backend — ChromaDB vector store (large, auto-rebuilt from PDFs)
chroma_storage/
db/
backend/db/
backend/data/db/

# Backend — FAISS vector store (live per-user data, not for version control —
# tracking these caused git reset/checkout/stash to silently overwrite/wipe
# users' persisted document indexes)
backend/data/faiss/

# Backend — SQLite chat-history DB (user data, not for version control)
chat.db
backend/chat.db
backend/data/chat.db

# Backend — local timestamped backups of data/ (contain user PII, never commit)
backend/backups/

# Node / Next.js
node_modules/
.next/
frontend/.next/

# Browser "Save Page As" artifacts (contain compiled CSS that triggers linter warnings)
*_files/
