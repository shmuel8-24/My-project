OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
SECRET_KEY=change-me-in-production-use-a-long-random-string
ADMIN_EMAIL=admin@example.com
PORT=5003
FLASK_ENV=development

# ── Presentation slide images (services/images.py) ──────────────────────────
# IMAGE_PROVIDER selects the slide-image backend: "unsplash" (default, free) or
# "none" to disable image lookups entirely. A future AI-image provider can be
# added as another option without changing slide-generation/rendering code.
# UNSPLASH_ACCESS_KEY: get a free key at https://unsplash.com/developers ->
# "New Application" -> copy the "Access Key" (NOT the Secret Key). Free tier
# allows 50 requests/hour. If unset, slides simply render without photos
# (existing placeholder visuals) — never a broken image.
IMAGE_PROVIDER=unsplash
UNSPLASH_ACCESS_KEY=

# ── SMTP mail server (OTP + password reset) ─────────────────────────────────
# Priority: SMTP (if MAIL_SERVER is set) → Resend API → terminal printout (dev)
#
# Gmail example (App Password required — not your regular password):
#   MAIL_SERVER=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USE_TLS=true
#   MAIL_USE_SSL=false
#   MAIL_USERNAME=your@gmail.com
#   MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx   ← Google App Password
#   MAIL_FROM=U-Note <your@gmail.com>
#
# Gmail with SSL on port 465:
#   MAIL_PORT=465
#   MAIL_USE_TLS=false
#   MAIL_USE_SSL=true
#
# Custom SMTP server:
#   MAIL_SERVER=mail.yourdomain.com
#   MAIL_PORT=587
#   MAIL_USE_TLS=true
#   MAIL_USE_SSL=false
#   MAIL_USERNAME=noreply@yourdomain.com
#   MAIL_PASSWORD=your-smtp-password
#   MAIL_FROM=U-Note <noreply@yourdomain.com>
#
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=U-Note <noreply@example.com>

# ── Resend API (alternative to SMTP — ignored when MAIL_SERVER is set) ───────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Frontend URL (used in reset-password email link) ─────────────────────────
FRONTEND_URL=http://localhost:3000

# ── One-time full database reset ─────────────────────────────────────────────
# Set RESET_DB=1, start the server ONCE, then remove this line and restart.
# WARNING: drops ALL SQL tables AND every ChromaDB collection.
# All users must re-register and re-upload their documents afterwards.
# RESET_DB=1
